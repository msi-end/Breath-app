rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Guidance audio is public read-only so it can be downloaded without an account.
    match /guidance/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Music library: catalog.json, MP3s and cover images are public read-only.
    match /music/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
